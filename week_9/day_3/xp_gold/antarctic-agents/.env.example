# Default: deterministic local run with no token.
USE_REAL_MODEL=false

# Required only when USE_REAL_MODEL=true.
# Create a read token at https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_your_read_token_here

# The exercise's original default is preserved.
HF_MODEL_ID=HuggingFaceH4/zephyr-7b-beta

# Reproducible random food yields.
SIMULATION_SEED=42
